# LLM Config
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL_NAME="gpt-4o-mini"
LLM_API_KEY="sk-dummy-key" # API proxy thường không cần key thật, nhưng thư viện yêu cầu phải có chuỗi

# TTS Config
TTS_API_URL="https://vbee.ai" # Tùy chỉnh theo local TTS của bạn

# Supabase Config (Chuẩn bị cho Phase sau)
SUPABASE_URL="https://your_project.supabase.co" # URL này chỉ dùng cho ví dụ, không dùng trong thực tế
SUPABASE_KEY="your_anon_key" # Key này chỉ dùng cho ví dụ, không dùng trong thực tế
